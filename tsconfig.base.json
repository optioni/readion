{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "paths": {
      "@readion/shared": ["./packages/shared/src/index.ts"],
      "@readion/shared/*": ["./packages/shared/src/*"],
      "@readion/db": ["./packages/db/src/index.ts"],
      "@readion/db/*": ["./packages/db/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".nuxt", ".output", "coverage"]
}
