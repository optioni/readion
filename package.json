{
  "name": "readion",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach --all --exclude . --parallel --interlaced run dev",
    "build": "yarn workspaces foreach --all --exclude . --topological-dev run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "yarn workspaces foreach --all --exclude . run typecheck",
    "build:packages": "yarn workspace @readion/shared build && yarn workspace @readion/db build",
    "test": "vitest run && yarn workspaces foreach --all --exclude . --parallel run test",
    "test:unit": "vitest run && yarn workspaces foreach --all --include '@readion/shared' --include '@readion/web' --parallel run test",
    "test:integration": "yarn workspaces foreach --all --include '@readion/api' --include '@readion/worker' --include '@readion/db' --parallel run test",
    "test:coverage": "yarn workspaces foreach --all --exclude . --parallel run test:coverage",
    "codegen": "orval"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.61.0",
    "@vitest/coverage-v8": "^4.1.9",
    "orval": "^7.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "yarn@4.16.0"
}
