# Application
NODE_ENV=development

# API base URL (origin only — the generated API client and auth calls already include the
# /api/v1 path prefix).
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional server-only API base URL used by SSR (auth bootstrap + data fetches). Set this to an
# in-cluster/private address when the public URL above is not routable from the server (e.g. a
# Kubernetes pod that would otherwise hairpin out through the ingress). Leave blank for local dev —
# SSR then reaches the API at NUXT_PUBLIC_API_BASE_URL.
NUXT_INTERNAL_API_BASE_URL=

# Umami analytics (self-hosted). Leave both blank to disable tracking entirely (local dev default).
# Set both to load the tracker and record page views + custom events. UUID-only user identification.
NUXT_PUBLIC_UMAMI_HOST=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
