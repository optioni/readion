# Application
NODE_ENV=development
SERVICE_NAME=readion-worker

# Database (PostgreSQL + pgvector)
# Discrete connection vars (not a DATABASE_URL) — see packages/db/src/mikro-orm.config.ts.
# Required in production; these dev defaults match docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=readion
DB_PASSWORD=readion
DB_NAME=readion

# Redis
REDIS_URL=redis://localhost:6379

# Scrapper sidecar
SCRAPPER_URL=http://localhost:3001

# Cert coverage thresholds
CERT_COVERAGE_MIN_CHUNKS_PER_DOMAIN=20
CERT_COVERAGE_TOTAL_CHUNK_MULTIPLE=3

# Lifecycle email
# Base URL the worker POSTs internal digest/nudge triggers to (the API).
INTERNAL_API_BASE_URL=http://localhost:3001
# Shared secret sent on internal lifecycle calls; must match the API's value.
INTERNAL_API_SECRET=replace-with-a-random-secret
# Day of week the weekly digest scheduler runs (0=Sunday .. 6=Saturday).
DIGEST_SEND_WEEKDAY=1
# Hour of day (0-23) the weekly digest scheduler runs.
DIGEST_SEND_HOUR=13
# Days of inactivity before an exam-ready enrollment is nudged.
NUDGE_ACTIVITY_LULL_DAYS=7

# Observability
LOG_LEVEL=info
PROMETHEUS_PORT=9091
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_RELEASE=git-sha
