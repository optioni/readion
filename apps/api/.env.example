# Application
PORT=3001
NODE_ENV=development
SERVICE_NAME=readion-api

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://readion:readion@localhost:5432/readion

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
WEB_BASE_URL=http://localhost:3000
BCRYPT_COST=12

# Email
# Local development defaults target Mailpit from docker-compose.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Readion <no-reply@readion.app>

# Observability
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_RELEASE=git-sha
