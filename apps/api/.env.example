# Application
PORT=3001
NODE_ENV=development
SERVICE_NAME=readion-api

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://readion:readion@localhost:5432/readion

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# Observability
LOG_LEVEL=info
