# Application
PORT=3001
NODE_ENV=development
SERVICE_NAME=readion-api

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://readion:readion@localhost:5432/readion

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
WEB_BASE_URL=http://localhost:3000
BCRYPT_COST=12

# Email
# Local development defaults target Mailpit from docker-compose.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Readion <no-reply@readion.app>

# Cert coverage thresholds
CERT_COVERAGE_MIN_CHUNKS_PER_DOMAIN=20
CERT_COVERAGE_TOTAL_CHUNK_MULTIPLE=3

# Readiness
# Minimum graded answers before a readiness score is shown (calibration gate).
READINESS_CALIBRATION_MIN_ANSWERS=10

# Diagnostic
# Number of questions in a diagnostic exam (range: 10-15)
DIAGNOSTIC_QUESTION_COUNT=12
# Number of completed sessions before re-prompting the diagnostic offer
DIAGNOSTIC_REPROMPT_AFTER_SESSIONS=1

# Session summary
# Maximum number of missed/unsure questions turned into a drill session.
# SUMMARY_DRILL_MAX_QUESTIONS=7
# Confidence score at or below which a response counts as "unsure" for drill targeting (1-5).
# SUMMARY_UNSURE_CONFIDENCE_THRESHOLD=2

# In-session agent tools
# Minimum cosine similarity for a chunk to count as covering a topic (0-1).
# AGENT_SIMILARITY_THRESHOLD=0.75
# Max chunks returned by the agent's semanticSearch / fetchMoreMaterial retrieval.
# AGENT_SEMANTIC_SEARCH_LIMIT=8

# Lifecycle email
# Public base URL of this API, used to build unsubscribe links in emails.
PUBLIC_API_URL=http://localhost:3001
# Shared secret guarding the worker -> API internal lifecycle endpoints.
INTERNAL_API_SECRET=replace-with-a-random-secret
# Day of week the weekly digest is sent (0=Sunday .. 6=Saturday).
DIGEST_SEND_WEEKDAY=1
# Hour of day (0-23) the weekly digest is sent.
DIGEST_SEND_HOUR=13
# Readiness percentage (0-100) at or above which an enrollment is "exam ready".
EXAM_READY_THRESHOLD=80
# Days of inactivity before an exam-ready enrollment is nudged.
NUDGE_ACTIVITY_LULL_DAYS=7
# Days to wait before sending a follow-up nudge.
NUDGE_FOLLOWUP_DELAY_DAYS=3
# Maximum number of follow-up nudges per enrollment.
NUDGE_MAX_FOLLOWUPS=1

# Observability
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_RELEASE=git-sha
